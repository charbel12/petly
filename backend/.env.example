PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://petly:petly@localhost:5432/petly

# Or individual vars (used if DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petly
DB_USER=petly
DB_PASSWORD=petly

# CORS — comma-separated allowlist of origins. Leave empty to allow all (dev only).
CORS_ORIGINS=

# Auth (used from Phase 1). CHANGE THE SECRET in any non-local environment.
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Global rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
