PORT=3000
NODE_ENV=development

# PostgreSQL (required)
DATABASE_URL=postgresql://petly:petly@localhost:5432/petly

# Or individual vars (used if DATABASE_URL is unset)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petly
DB_USER=petly
DB_PASSWORD=petly

# CORS — comma-separated allowlist of origins. Leave empty to allow all (dev only).
CORS_ORIGINS=

# Auth (Phase 1). CHANGE THE SECRET in any non-local environment.
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Seeded admin (created on db:seed / API bootstrap)
ADMIN_EMAIL=admin@petly.local
ADMIN_PASSWORD=changeme-admin

# Demo partner (created on db:seed / API bootstrap)
# partner@petly.local / changeme-partner

# Google Sign-In — comma-separated OAuth client IDs used as ID-token audience
# (Web + Android + iOS). Leave empty to disable Google login.
GOOGLE_CLIENT_IDS=

# Trust the first proxy hop so rate limiting can use X-Forwarded-For.
# Auto-enabled when NODE_ENV=production or RENDER is set. Set 0 to disable.
# TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
