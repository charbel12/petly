generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  client
  partner
  admin
}

enum UserStatus {
  active
  suspended
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum AuthProvider {
  google
}

enum PetType {
  dog
  cat
  bird
  fish
  rabbit
  other
}

enum ItemCategory {
  food
  toys
  cleaning
  health
  accessories
  other
}

enum FavoriteEntityType {
  store
  vet
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(120)
  phone        String?    @unique @db.VarChar(64)
  deviceId     String?    @unique @map("device_id") @db.VarChar(64)
  email        String?    @unique @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  role         UserRole   @default(client)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  pets           Pet[]
  refreshTokens  RefreshToken[]
  identities     AuthIdentity[]
  ownedVets      Vet[]          @relation("VetOwner")
  ownedStores    Store[]        @relation("StoreOwner")
  reviewedVets   Vet[]          @relation("VetReviewer")
  reviewedStores Store[]        @relation("StoreReviewer")
  favorites      Favorite[]
  reviews        Review[]
  deviceTokens   DeviceToken[]

  @@index([deviceId])
  @@map("users")
}

model Pet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(80)
  type      PetType  @default(other)
  age       Decimal  @default(0) @db.Decimal(5, 1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pets")
}

model Vet {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(160)
  phone            String        @db.VarChar(32)
  location         String        @db.VarChar(200)
  latitude         Float?
  longitude        Float?
  services         String[]      @default([])
  petTypes         PetType[]     @default([]) @map("pet_types")
  verified         Boolean       @default(false)
  isEmergency      Boolean       @default(false) @map("is_emergency")
  isOpenNow        Boolean       @default(true) @map("is_open_now")
  featured         Boolean       @default(false)
  imageUrl         String?       @map("image_url") @db.VarChar(500)
  ownerUserId      String?       @map("owner_user_id") @db.Uuid
  status           ListingStatus @default(approved)
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz
  reviewerId       String?       @map("reviewer_id") @db.Uuid
  hours            Json?
  avgRating        Float         @default(0) @map("avg_rating")
  ratingCount      Int           @default(0) @map("rating_count")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner    User? @relation("VetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewer User? @relation("VetReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([verified])
  @@index([featured])
  @@index([status])
  @@index([ownerUserId])
  @@map("vets")
}

model Store {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(160)
  type             String        @db.VarChar(60)
  location         String        @db.VarChar(200)
  phone            String?       @db.VarChar(32)
  latitude         Float?
  longitude        Float?
  featured         Boolean       @default(false)
  isOpenNow        Boolean       @default(true) @map("is_open_now")
  imageUrl         String?       @map("image_url") @db.VarChar(500)
  services         String[]      @default([])
  petTypes         PetType[]     @default([]) @map("pet_types")
  ownerUserId      String?       @map("owner_user_id") @db.Uuid
  status           ListingStatus @default(approved)
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  submittedAt      DateTime?     @map("submitted_at") @db.Timestamptz
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz
  reviewerId       String?       @map("reviewer_id") @db.Uuid
  hours            Json?
  avgRating        Float         @default(0) @map("avg_rating")
  ratingCount      Int           @default(0) @map("rating_count")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner    User?      @relation("StoreOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewer User?      @relation("StoreReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  items    StoreItem[]

  @@index([featured])
  @@index([type])
  @@index([status])
  @@index([ownerUserId])
  @@map("stores")
}

model StoreItem {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  name        String   @db.VarChar(160)
  description String?  @db.VarChar(500)
  price       Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(3)
  imageUrl    String?      @map("image_url") @db.VarChar(500)
  inStock     Boolean      @default(true) @map("in_stock")
  sortOrder   Int          @default(0) @map("sort_order")
  category    ItemCategory @default(other)
  petTypes    PetType[]    @default([]) @map("pet_types")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_items")
}

model WhatsAppClick {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  userId     String?  @map("user_id") @db.Uuid
  deviceId   String?  @map("device_id") @db.VarChar(64)
  source     String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("whatsapp_clicks")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthIdentity {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  provider    AuthProvider
  providerSub String       @map("provider_sub") @db.VarChar(255)
  email       String?      @db.VarChar(255)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("auth_identities")
}

model Favorite {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  entityType FavoriteEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@map("favorites")
}

model Review {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  entityType FavoriteEntityType @map("entity_type")
  entityId   String             @map("entity_id") @db.Uuid
  rating     Int
  comment    String?            @db.VarChar(500)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("reviews")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
