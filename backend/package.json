{
  "name": "petly-backend",
  "version": "1.0.0",
  "description": "Petly API — pet services platform for Lebanon",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "migrate:new": "node-pg-migrate create -m migrations -j sql",
    "db:seed": "tsx src/db/seed.ts",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 \"src/**/*.test.ts\""
  },
  "keywords": [
    "petly",
    "pets",
    "lebanon"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.3",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
